<Window x:Class="Tangerine.App.Actions.FloatWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Floating file"
        Width="176"
        SizeToContent="Height"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        Topmost="True"
        FontFamily="Segoe UI Variable Text, Segoe UI">
    <Border Margin="10" Background="#F21E1E21" CornerRadius="10" BorderBrush="#40FFFFFF" BorderThickness="1">
        <Border.Effect>
            <DropShadowEffect BlurRadius="18" ShadowDepth="3" Opacity="0.4" />
        </Border.Effect>
        <StackPanel>
            <Grid x:Name="Header" Background="Transparent" Cursor="SizeAll" Height="26" MouseLeftButtonDown="OnHeaderDown">
                <TextBlock Text="&#xE718;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="11" Foreground="#FF8A1F"
                           VerticalAlignment="Center" Margin="10,0,0,0" />
                <Button HorizontalAlignment="Right" Width="26" Height="26" Click="OnClose" ToolTip="Close" Cursor="Hand">
                    <Button.Template>
                        <ControlTemplate TargetType="Button">
                            <Border x:Name="Bd" Background="Transparent" CornerRadius="0,10,0,0">
                                <TextBlock Text="&#xE711;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="10"
                                           Foreground="#C8C8C8" HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="Bd" Property="Background" Value="#C42B1C" />
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Button.Template>
                </Button>
            </Grid>
            <Border x:Name="DragSource" Background="Transparent" Cursor="Hand" Padding="12,0,12,12"
                    MouseLeftButtonDown="OnSourceDown" MouseMove="OnSourceMove" ToolTip="Drag me where you need the file">
                <StackPanel>
                    <Grid Height="96">
                        <Image x:Name="Thumb" Stretch="Uniform" MaxHeight="96" RenderOptions.BitmapScalingMode="HighQuality" />
                        <Border x:Name="CountBadge" Visibility="Collapsed" Background="#FF8A1F" CornerRadius="9" MinWidth="18" Height="18"
                                HorizontalAlignment="Right" VerticalAlignment="Top" Padding="5,0">
                            <TextBlock x:Name="CountText" Foreground="White" FontSize="11" FontWeight="SemiBold"
                                       HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                    </Grid>
                    <TextBlock x:Name="NameText" Foreground="#F2F2F2" FontSize="12" Margin="0,8,0,0"
                               TextAlignment="Center" TextTrimming="CharacterEllipsis" />
                </StackPanel>
            </Border>
        </StackPanel>
    </Border>
</Window>
