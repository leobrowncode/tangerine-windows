<Window x:Class="Tangerine.App.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        ThemeMode="System"
        Title="Tangerine Settings"
        Width="620" Height="760"
        MinWidth="520" MinHeight="480"
        WindowStartupLocation="CenterScreen"
        Icon="pack://application:,,,/Assets/Tangerine.ico">
    <Window.Resources>
        <Style x:Key="SectionTitle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="14" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Margin" Value="0,22,0,8" />
        </Style>
        <Style x:Key="Card" TargetType="Border">
            <Setter Property="Background" Value="{DynamicResource CardBackgroundFillColorDefaultBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource CardStrokeColorDefaultBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="8" />
            <Setter Property="Padding" Value="16,12" />
            <Setter Property="Margin" Value="0,0,0,4" />
        </Style>
        <Style x:Key="Hint" TargetType="TextBlock">
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Opacity" Value="0.7" />
            <Setter Property="TextWrapping" Value="Wrap" />
            <Setter Property="Margin" Value="0,2,0,0" />
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="28,20,28,12">
            <StackPanel>
                <DockPanel>
                    <Image Source="pack://application:,,,/Assets/Tangerine.png" Width="56" Height="56" Margin="0,0,16,0" />
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="Tangerine for Windows" FontSize="24" FontWeight="SemiBold" />
                        <TextBlock Text="The zero-click offline file converter." Opacity="0.75" />
                    </StackPanel>
                </DockPanel>

                <TextBlock Text="How it works" Style="{StaticResource SectionTitle}" />
                <Border Style="{StaticResource Card}">
                    <StackPanel>
                        <TextBlock TextWrapping="Wrap"><Run FontWeight="SemiBold">1.</Run> Start dragging any file in Explorer or on the desktop.</TextBlock>
                        <TextBlock TextWrapping="Wrap" Margin="0,6,0,0"><Run FontWeight="SemiBold">2.</Run> Without letting go, tap <Run x:Name="ConvertKeyRun" FontWeight="SemiBold">Shift</Run>. A wheel of formats and tools opens around your cursor.</TextBlock>
                        <TextBlock TextWrapping="Wrap" Margin="0,6,0,0"><Run FontWeight="SemiBold">3.</Run> Drop the file on what you need. The result is saved next to the original.</TextBlock>
                        <TextBlock TextWrapping="Wrap" Margin="0,10,0,0" Style="{StaticResource Hint}">Tap <Run x:Name="ActionsKeyRun">Ctrl</Run> instead for file actions: Share, Float, Copy, Move, Copy path and Terminal. They work with folders too. Drop in the centre or press Esc to cancel.</TextBlock>
                    </StackPanel>
                </Border>

                <TextBlock Text="Keys" Style="{StaticResource SectionTitle}" />
                <Border Style="{StaticResource Card}">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="160" />
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <TextBlock Text="Conversion wheel" VerticalAlignment="Center" />
                        <ComboBox x:Name="ConvertKeyBox" Grid.Column="1" SelectionChanged="OnKeysChanged" />
                        <TextBlock Grid.Row="1" Text="File actions wheel" VerticalAlignment="Center" Margin="0,8,0,0" />
                        <ComboBox x:Name="ActionsKeyBox" Grid.Row="1" Grid.Column="1" Margin="0,8,0,0" SelectionChanged="OnKeysChanged" />
                        <TextBlock x:Name="KeyWarning" Grid.Row="2" Grid.ColumnSpan="2" Foreground="#E0533A" Margin="0,8,0,0"
                                   Text="Pick a different key for each wheel." Visibility="Collapsed" />
                    </Grid>
                </Border>

                <TextBlock Text="Where results go" Style="{StaticResource SectionTitle}" />
                <Border Style="{StaticResource Card}">
                    <StackPanel>
                        <RadioButton x:Name="NextToOriginal" Content="Next to the original file" GroupName="Output" />
                        <RadioButton x:Name="ToFolder" Content="Always in this folder:" GroupName="Output" Margin="0,6,0,0" />
                        <DockPanel Margin="28,6,0,0" IsEnabled="{Binding IsChecked, ElementName=ToFolder}">
                            <Button DockPanel.Dock="Right" Content="Browse…" Margin="8,0,0,0" Click="OnBrowseOutput" />
                            <TextBox x:Name="OutputFolderBox" />
                        </DockPanel>
                        <CheckBox x:Name="RevealBox" Content="Show results in File Explorer when done" Margin="0,10,0,0" />
                    </StackPanel>
                </Border>

                <TextBlock Text="Quality" Style="{StaticResource SectionTitle}" />
                <Border Style="{StaticResource Card}">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="200" />
                            <ColumnDefinition Width="44" />
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock Text="Image quality" />
                            <TextBlock Text="JPG, WebP and AVIF conversions" Style="{StaticResource Hint}" />
                        </StackPanel>
                        <Slider x:Name="QualitySlider" Grid.Column="1" Minimum="40" Maximum="100" TickFrequency="5" IsSnapToTickEnabled="True" VerticalAlignment="Center" />
                        <TextBlock Grid.Column="2" Text="{Binding Value, ElementName=QualitySlider}" VerticalAlignment="Center" HorizontalAlignment="Right" />

                        <StackPanel Grid.Row="1" Margin="0,12,0,0" VerticalAlignment="Center">
                            <TextBlock Text="Compress quality" />
                            <TextBlock Text="Lower is smaller" Style="{StaticResource Hint}" />
                        </StackPanel>
                        <Slider x:Name="CompressSlider" Grid.Row="1" Grid.Column="1" Margin="0,12,0,0" Minimum="30" Maximum="95" TickFrequency="5" IsSnapToTickEnabled="True" VerticalAlignment="Center" />
                        <TextBlock Grid.Row="1" Grid.Column="2" Margin="0,12,0,0" Text="{Binding Value, ElementName=CompressSlider}" VerticalAlignment="Center" HorizontalAlignment="Right" />

                        <StackPanel Grid.Row="2" Margin="0,12,0,0" VerticalAlignment="Center">
                            <TextBlock Text="PDF page images" />
                            <TextBlock Text="Resolution when exporting pages" Style="{StaticResource Hint}" />
                        </StackPanel>
                        <ComboBox x:Name="DpiBox" Grid.Row="2" Grid.Column="1" Grid.ColumnSpan="2" Margin="0,12,0,0" />
                    </Grid>
                </Border>

                <TextBlock Text="Helpers" Style="{StaticResource SectionTitle}" />
                <Border Style="{StaticResource Card}">
                    <StackPanel>
                        <DockPanel>
                            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                                <Button x:Name="InstallFfmpegButton" Content="Install" Click="OnInstallFfmpeg" Margin="0,0,8,0" />
                                <Button Content="Locate…" Click="OnLocateFfmpeg" />
                            </StackPanel>
                            <StackPanel>
                                <TextBlock Text="FFmpeg (audio and video)" />
                                <TextBlock x:Name="FfmpegStatus" Style="{StaticResource Hint}" />
                            </StackPanel>
                        </DockPanel>
                        <StackPanel Margin="0,14,0,0">
                            <TextBlock Text="Office documents to PDF" />
                            <TextBlock x:Name="OfficeStatus" Style="{StaticResource Hint}" />
                        </StackPanel>
                    </StackPanel>
                </Border>

                <TextBlock Text="General" Style="{StaticResource SectionTitle}" />
                <Border Style="{StaticResource Card}">
                    <StackPanel>
                        <CheckBox x:Name="LaunchBox" Content="Start Tangerine when I sign in" />
                        <CheckBox x:Name="PausedBox" Content="Pause the wheel" Margin="0,8,0,0" />
                    </StackPanel>
                </Border>

                <TextBlock Margin="0,20,0,4" Style="{StaticResource Hint}" TextAlignment="Center"
                           Text="Your files stay on your PC. Conversions and tools run locally and nothing is uploaded." />
            </StackPanel>
        </ScrollViewer>

        <Border Grid.Row="1" Background="{DynamicResource LayerFillColorDefaultBrush}" BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}" BorderThickness="0,1,0,0" Padding="28,14">
            <DockPanel>
                <Button DockPanel.Dock="Left" Content="Quit Tangerine" Click="OnQuit" />
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button Content="Cancel" IsCancel="True" MinWidth="96" Margin="0,0,8,0" />
                    <Button x:Name="SaveButton" Content="Save" IsDefault="True" MinWidth="96" Style="{DynamicResource AccentButtonStyle}" Click="OnSave" />
                </StackPanel>
            </DockPanel>
        </Border>
    </Grid>
</Window>
