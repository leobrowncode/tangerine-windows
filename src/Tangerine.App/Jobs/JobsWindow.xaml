<Window x:Class="Tangerine.App.Jobs.JobsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Tangerine"
        Width="380"
        SizeToContent="Height"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        ShowActivated="False"
        Topmost="True"
        FontFamily="Segoe UI Variable Text, Segoe UI">
    <Window.Resources>
        <SolidColorBrush x:Key="CardBrush" Color="#F21E1E21" />
        <SolidColorBrush x:Key="TextBrush" Color="#F2F2F2" />
        <SolidColorBrush x:Key="DimBrush" Color="#A3A3AA" />
        <SolidColorBrush x:Key="AccentBrush" Color="#FF8A1F" />

        <Style x:Key="CardButton" TargetType="Button">
            <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
            <Setter Property="Background" Value="#2EFFFFFF" />
            <Setter Property="Padding" Value="10,4" />
            <Setter Property="Margin" Value="6,0,0,0" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" Background="{TemplateBinding Background}" CornerRadius="4" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#48FFFFFF" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <ItemsControl x:Name="Jobs" Margin="12">
        <ItemsControl.ItemTemplate>
            <DataTemplate>
                <Border Background="{StaticResource CardBrush}" CornerRadius="8" Padding="14,12" Margin="0,8,0,0"
                        BorderBrush="#33FFFFFF" BorderThickness="1">
                    <Border.Effect>
                        <DropShadowEffect BlurRadius="18" ShadowDepth="3" Opacity="0.35" />
                    </Border.Effect>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <TextBlock Grid.RowSpan="2" Text="{Binding StateGlyph}" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets"
                                   FontSize="18" Foreground="{StaticResource AccentBrush}" Margin="0,2,12,0" VerticalAlignment="Top" />
                        <TextBlock Grid.Column="1" Text="{Binding Title}" Foreground="{StaticResource TextBrush}" FontSize="13"
                                   FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                        <Button Grid.Column="2" Content="&#xE711;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="10"
                                Style="{StaticResource CardButton}" Background="Transparent" Padding="6,4" Click="OnDismiss"
                                ToolTip="Dismiss" />
                        <TextBlock Grid.Row="1" Grid.Column="1" Grid.ColumnSpan="2" Text="{Binding Detail}" Foreground="{StaticResource DimBrush}"
                                   FontSize="12" TextTrimming="CharacterEllipsis" Margin="0,1,0,0" />

                        <ProgressBar Grid.Row="2" Grid.Column="1" Grid.ColumnSpan="2" Height="4" Margin="0,10,0,2"
                                     Minimum="0" Maximum="100" Value="{Binding Percent, Mode=OneWay}"
                                     IsIndeterminate="{Binding IsIndeterminate, Mode=OneWay}"
                                     Visibility="{Binding ProgressVisibility}"
                                     Foreground="{StaticResource AccentBrush}" Background="#33FFFFFF" BorderThickness="0" />

                        <DockPanel Grid.Row="3" Grid.Column="1" Grid.ColumnSpan="2" Margin="0,8,0,0" LastChildFill="True">
                            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                                <Button Content="Cancel" Style="{StaticResource CardButton}" Visibility="{Binding CancelVisibility}" Click="OnCancel" />
                                <Button Content="{Binding FixLabel}" Style="{StaticResource CardButton}" Visibility="{Binding FixVisibility}" Click="OnFix" />
                                <Button Content="Show" Style="{StaticResource CardButton}" Visibility="{Binding RevealVisibility}" Click="OnReveal" />
                                <Button Content="Open" Style="{StaticResource CardButton}" Visibility="{Binding RevealVisibility}" Click="OnOpen" />
                            </StackPanel>
                            <TextBlock Text="{Binding Status}" Foreground="{StaticResource DimBrush}" FontSize="12"
                                       TextWrapping="Wrap" MaxHeight="64" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
                        </DockPanel>
                    </Grid>
                </Border>
            </DataTemplate>
        </ItemsControl.ItemTemplate>
    </ItemsControl>
</Window>
